{
  "name": "slidev-theme-db",
  "version": "0.0.1",
  "type": "module",
  "description": "Slidev theme cloning the TU Dresden / Dresden Database Research Group PowerPoint template",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=0.48.0"
  },
  "scripts": {
    "build": "slidev build examples/slides.md",
    "dev": "slidev examples/slides.md --remote",
    "export": "slidev export examples/slides.md"
  },
  "dependencies": {
    "shiki": "^4.2.0",
    "slidev-addon-gsap": "^0.0.4"
  },
  "devDependencies": {
    "@slidev/cli": "^52.16.0",
    "@slidev/parser": "^52.16.0",
    "vue": "^3.5.38"
  },
  "slidev": {
    "defaults": {
      "addons": [
        "gsap"
      ],
      "aspectRatio": "16/9",
      "canvasWidth": 960,
      "colorSchema": "light",
      "mdc": true,
      "comark": true,
      "presenter": true,
      "titleTemplate": "%s",
      "transition": "slide-fade-left | slide-fade-right",
      "fonts": {
        "sans": "NotoSans",
        "mono": "FiraCode",
        "provider": null
      }
    }
  }
}
