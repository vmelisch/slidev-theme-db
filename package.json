{
  "name": "slidev-theme-db",
  "version": "0.0.1",
  "type": "module",
  "description": "Slidev theme cloning the TU Dresden / Dresden Database Research Group PowerPoint template",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=0.48.0"
  },
  "scripts": {
    "build": "slidev build examples/slides.md",
    "dev": "slidev examples/slides.md --open",
    "export": "slidev export examples/slides.md"
  },
  "dependencies": {
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@slidev/cli": "^52.16.0",
    "slidev-addon-gsap": "link:../slidev-addon-gsap",
    "vue": "^3.5.38"
  },
  "slidev": {
    "defaults": {
      "addons": [
        "gsap"
      ],
      "canvasWidth": 720,
      "colorSchema": "light",
      "comark": true,
      "fonts": {
        "sans": "Noto Sans",
        "weights": "400,500,700",
        "provider": "google"
      }
    }
  }
}
